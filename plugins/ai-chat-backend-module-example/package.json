{
  "name": "@kwkevinchan/backstage-plugin-ai-chat-backend-module-example",
  "version": "0.0.0",
  "description": "Private example backend module of the AI chat for Backstage. It registers one agent and depends only on the extension-point package. Copy from this directory; do not publish it.",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "ai",
    "chat"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/tree/main/plugins/ai-chat-backend-module-example",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat",
    "directory": "plugins/ai-chat-backend-module-example"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "ai-chat",
    "pluginPackage": "@kwkevinchan/backstage-plugin-ai-chat-backend"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "backstage:^",
    "@kwkevinchan/backstage-plugin-ai-chat-node": "workspace:^"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^"
  },
  "private": true
}
