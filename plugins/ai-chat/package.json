{
  "name": "@kwkevinchan/backstage-plugin-ai-chat",
  "version": "0.0.0",
  "description": "Unofficial Backstage frontend plugin for an AI chat: streaming answers, tool calls and an approval card for every action that is not read-only",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "ai",
    "chat",
    "llm"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/tree/main/plugins/ai-chat",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat",
    "directory": "plugins/ai-chat"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "ai-chat",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-ai-chat",
      "@kwkevinchan/backstage-plugin-ai-chat-backend",
      "@kwkevinchan/backstage-plugin-ai-chat-common"
    ]
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.170",
    "@backstage/core-compat-api": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-signals-react": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@kwkevinchan/backstage-plugin-ai-chat-common": "workspace:^",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "ai": "7.0.166",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/core-app-api": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  }
}
