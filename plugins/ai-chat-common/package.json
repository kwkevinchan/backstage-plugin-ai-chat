{
  "name": "@kwkevinchan/backstage-plugin-ai-chat-common",
  "version": "0.0.0",
  "description": "Types and definitions shared by the frontend and the backend of the AI chat for Backstage",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "ai",
    "chat",
    "llm"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/tree/main/plugins/ai-chat-common",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat",
    "directory": "plugins/ai-chat-common"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "common-library",
    "pluginId": "ai-chat",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-ai-chat",
      "@kwkevinchan/backstage-plugin-ai-chat-backend",
      "@kwkevinchan/backstage-plugin-ai-chat-common"
    ]
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^"
  }
}
