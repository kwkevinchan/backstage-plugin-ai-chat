{
  "name": "@kwkevinchan/backstage-plugin-ai-chat-backend",
  "version": "0.0.0",
  "description": "Unofficial Backstage backend plugin for an AI chat: an LLM that calls the actions of the actions registry as the signed-in user, with approval for every action that is not read-only",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "ai",
    "chat",
    "llm"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/tree/main/plugins/ai-chat-backend",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat",
    "directory": "plugins/ai-chat-backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./common": "./src/common/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "common": [
        "src/common/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "ai-chat",
    "pluginPackages": [
      "@kwkevinchan/backstage-plugin-ai-chat",
      "@kwkevinchan/backstage-plugin-ai-chat-backend",
      "@kwkevinchan/backstage-plugin-ai-chat-common"
    ]
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts",
    "src/schema/openapi.yaml"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/types": "backstage:^",
    "express": "^4.22.0",
    "express-promise-router": "^4.1.0",
    "knex": "^3.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "backstage:^",
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@types/express": "^4.17.6",
    "@types/json-schema": "^7.0.15",
    "@types/supertest": "^2.0.12",
    "better-sqlite3": "^12.0.0",
    "pg": "^8.11.3",
    "supertest": "^6.2.4",
    "yaml": "^2.7.0"
  }
}
