{
  "name": "@kwkevinchan/ai-chat-harness",
  "version": "0.0.0",
  "description": "Core of the AI chat harness for Backstage: the agent loop, the tool policy and the model input, with no dependency on Backstage, HTTP or a database",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "chat",
    "agent",
    "llm",
    "harness"
  ],
  "homepage": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/tree/main/packages/ai-chat-harness",
  "bugs": {
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwkevinchan/backstage-plugin-ai-chat",
    "directory": "packages/ai-chat-harness"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "src/testing/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "node-library"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@types/eslint": "^8.56.0",
    "eslint": "^8.57.0"
  }
}
